# JANGAN di-enable. Dinyalakan issboard-helper.socket, satu per koneksi.
#
# Bagian issboard yang berjalan sebagai ROOT. Kemampuannya daftar tertutup
# (internal/ops): zpool scrub/-s/-p, smartctl -t short/long/-X, menulis
# zfs_arc_max, zfs snapshot, zfs destroy SATU snapshot (tanpa -r), zfs create
# -u + zfs set/inherit untuk properti tertentu, dan systemctl start
# issboard-smart.service / sanoid.service. Tiap target dicocokkan dengan
# daftar dari sistem sebelum apa pun dijalankan.
#
# ⚠️ Unit ini punya mount namespace sendiri (ProtectSystem). Karena itu
# dataset baru dibuat dengan `zfs create -u` lalu di-mount lewat systemd-run,
# yang berjalan di namespace host — mount dari dalam sini tidak terlihat di host.
[Unit]
Description=issboard-helper: satu aksi root untuk issboard
After=issboard-helper.socket

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/issboard-helper
StandardInput=socket
StandardOutput=socket
# Log audit masuk journald: journalctl -u 'issboard-helper@*'
StandardError=journal
User=root
TimeoutStartSec=90

# Pengerasan. Lebih longgar dari issboard.service karena memang harus:
#  - /dev/zfs dan /dev/sdX dibutuhkan zpool dan smartctl → PrivateDevices=no
#  - /sys/module/zfs/parameters harus bisa ditulis → ProtectKernelTunables=no
#  - /etc/modprobe.d untuk batas ARC yang selamat reboot → ReadWritePaths
ProtectSystem=strict
ReadWritePaths=/etc/modprobe.d
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
# Tidak ada jaringan: AF_UNIX untuk D-Bus (systemctl start) dan AF_NETLINK
# yang dipakai sebagian perkakas ZFS.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
