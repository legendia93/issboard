# JANGAN di-enable. Unit ini dinyalakan oleh issboard.socket.
[Unit]
Description=issboard (dashboard kesehatan host)
Requires=issboard.socket
After=issboard.socket

[Service]
Type=exec
ExecStart=/usr/local/bin/issboard -config /etc/issboard.yaml

# User sistem sendiri, bukan root. issboard v1 read-only.
User=issboard
Group=issboard
# Grup docker hanya untuk MEMBACA socket. Perlu disadari: grup docker setara
# root di mesin ini — pembatas sebenarnya ada di v1 yang tidak bermutasi.
SupplementaryGroups=docker

# Pengerasan: tidak butuh tulis ke mana pun.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Keluar sendiri saat idle adalah SUKSES, bukan kegagalan.
Restart=no

[Install]
# sengaja kosong — lihat catatan di atas
