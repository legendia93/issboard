# JANGAN di-enable. Unit ini dinyalakan oleh issboard.socket.
[Unit]
Description=issboard (dashboard kesehatan host)
Requires=issboard.socket
After=issboard.socket

[Service]
Type=exec
ExecStart=/usr/local/bin/issboard -config /etc/issboard.yaml

# User sistem sendiri, bukan root. Aksi root (scrub, SMART, ARC) dikerjakan
# issboard-helper lewat socket-nya — issboard tidak pernah memakai sudo, dan
# NoNewPrivileges di bawah membuatnya mustahil.
User=issboard
Group=issboard
# ⚠️ Grup docker setara root di mesin ini, dan sejak fase 8 dipakai juga untuk
# start/stop/restart/hapus container. Pembatasnya sekarang autentikasi di
# issboard (fase 7): tiap aksi butuh sesi + token CSRF, dan dicatat di journal.
SupplementaryGroups=docker

# Pengerasan: tidak butuh tulis ke mana pun.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Keluar sendiri saat idle adalah SUKSES, bukan kegagalan.
Restart=no

[Install]
# sengaja kosong — lihat catatan di atas
